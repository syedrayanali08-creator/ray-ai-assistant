# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- Core -------------------------------------------------------------------
# Bearer token required on every API request except /health (ADR-0006).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RAY_API_TOKEN=change-me

# Where the API listens. Keep 127.0.0.1 unless you intend to expose Ray.
RAY_HOST=127.0.0.1
RAY_PORT=8000

# development | production
RAY_ENV=development

# --- Database ---------------------------------------------------------------
# Matches docker-compose.yml. Port 5433 avoids clashing with a local Postgres.
RAY_DATABASE_URL=postgresql+asyncpg://ray:ray@localhost:5433/ray

# --- Single local user ------------------------------------------------------
RAY_USER_NAME=Rayan
RAY_USER_EMAIL=
RAY_USER_TIMEZONE=America/Toronto

# --- LLM providers (ADR-0001, ADR-0015) -------------------------------------
# gemini | ollama | mock
RAY_LLM_PROVIDER=gemini
# Optional: a faster provider for routing and extraction calls (Phase 4).
# RAY_LLM_ROUTER_PROVIDER=ollama
# Used when the primary provider is rate limited or unavailable. "mock" is always
# appended to the chain, so Ray answers even with nothing configured.
RAY_LLM_FALLBACK_PROVIDER=ollama

# Free-tier key from https://aistudio.google.com/apikey — never commit a real one.
RAY_GEMINI_API_KEY=
RAY_GEMINI_MODEL=gemini-flash-latest
RAY_OLLAMA_HOST=http://127.0.0.1:11434
RAY_OLLAMA_MODEL=llama3.2

# Conversation shaping.
RAY_LLM_TEMPERATURE=0.7
RAY_HISTORY_WINDOW=20

# --- Memory (Phase 3, ADR-0003, ADR-0013, ADR-0016) -------------------------
# Embeddings run locally. The dimension must match the vector column size, so
# changing it needs a migration.
RAY_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAY_EMBEDDING_DIM=384
# sentence-transformers | hashing
# "hashing" needs no torch install and no download; it matches on shared words
# rather than meaning. Ray falls back to it automatically if torch is missing.
# Switching backends invalidates existing embeddings (they are different vector
# spaces) and requires re-embedding.
RAY_EMBEDDING_BACKEND=sentence-transformers

# Turn retrieval and learning off entirely.
RAY_MEMORY_ENABLED=true
# Learning costs one cheap model call per exchange, made after the answer is sent.
RAY_MEMORY_EXTRACTION_ENABLED=true
# How many memories may reach the prompt, and the floor a memory must score to be
# worth the context it spends.
RAY_MEMORY_TOP_K=5
RAY_MEMORY_MIN_SCORE=0.35
RAY_MEMORY_CONTEXT_CHARS=2000

# --- Voice (Phase 2/6, ADR-0009) --------------------------------------------
# browser | local  -- "local" uses faster-whisper and Piper, added in Phase 6.
# Download models with: uv run python scripts/download_voice_models.py
RAY_STT_BACKEND=browser
RAY_TTS_BACKEND=browser
RAY_WAKE_WORD_ENABLED=false

# Directory for downloaded Piper/openWakeWord models. A bare filename in
# RAY_TTS_VOICE is resolved against this directory.
RAY_VOICE_MODELS_DIR=~/.local/share/ray/voices
RAY_TTS_VOICE=en_US-lessac-low.onnx

# faster-whisper model size: tiny, base, small, medium, large, or a path.
RAY_STT_MODEL=tiny
# ISO language code or leave blank for auto-detect.
RAY_STT_LANGUAGE=

# Optional: path to an openWakeWord .tflite model. If unset and faster-whisper is
# installed, Ray falls back to a keyword-spotting wake word using the STT model.
RAY_WAKE_WORD_MODEL=
# Comma-separated wake words (case-insensitive).
RAY_WAKE_WORDS=ray,jarvis

# --- Frontend ---------------------------------------------------------------
# Server-side only. The token is never exposed to browser JavaScript.
RAY_API_URL=http://127.0.0.1:8000
