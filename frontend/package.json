{
  "name": "ray-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "generate:api": "cd ../backend && uv run python scripts/export_openapi.py ../frontend/openapi.json && cd ../frontend && openapi-typescript openapi.json -o src/lib/api-types.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "next": "15.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "2.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "22.12.0",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "eslint": "9.17.0",
    "eslint-config-next": "15.1.3",
    "openapi-typescript": "7.4.4",
    "tailwindcss": "4.1.11",
    "typescript": "5.7.2",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@9.15.0"
}
